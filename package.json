{
  "name": "isbn3",
  "description": "ISBN utils: parse, validate, format, audit",
  "version": "3.0.0",
  "type": "module",
  "authors": [
    "Hetappi <hetappi.pm@gmail.com>",
    "Tadas S. <tadas@yoyo.lt>",
    "Maxime L. <k@maxlath.eu>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/inventaire/isbn3",
  "repository": {
    "type": "git",
    "url": "git://github.com/inventaire/isbn3.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isbn": "./dist/bin/isbn.js",
    "isbn-audit": "./dist/bin/isbn-audit.js",
    "isbn-checksum": "./dist/bin/isbn-checksum.js"
  },
  "scripts": {
    "build": "tsdown",
    "test": "tsx --test test/*.test.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "update-groups": "tsx scripts/update_groups.ts",
    "benchmark": "tsx benchmark/run.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.19.21",
    "@types/xml2js": "^0.4.14",
    "tsdown": "^0.22.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "xml2js": "^0.6.2"
  },
  "bugs": {
    "url": "https://github.com/inventaire/isbn3/issues"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "keywords": [
    "ISBN",
    "ISBN 10",
    "ISBN 13",
    "parser",
    "parse",
    "audit",
    "publisher",
    "checksum",
    "esm",
    "typescript"
  ]
}
