{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // tsdown handles bundling, declarations and source maps; tsc is type-check only.
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "benchmark", "tsdown.config.ts"]
}
